# Application Settings
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Database Settings
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_seller
# DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ai_seller
# SQLite (fast local dev, no Postgres needed):
DATABASE_URL=sqlite+aiosqlite:////tmp/ai_live.db
DATABASE_SYNC_URL=sqlite:////tmp/ai_live.db

# Redis Settings
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
# Collection names (defaults; change only if you recreated collections):
# QDRANT_SALES_COLLECTION=sales_knowledge
# QDRANT_KNOWLEDGE_COLLECTION=product_knowledge

# LLM Provider Settings
# Available providers: ollama | gigachat | openai | claude | deepseek.
# GigaChat is geo/network-restricted (RU); on other networks use Ollama as
# primary so the agent replies without a cloud round-trip:
LLM_PROVIDER=ollama
LLM_PRIMARY=ollama
LLM_FALLBACK=gigachat

# Ollama Settings (local LLM)
# Make sure the model is pulled first:  ollama pull llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:latest

# GigaChat Settings
# Provide either the pre-encoded GIGACHAT_AUTH_KEY (base64 of client_id:secret),
# or GIGACHAT_CLIENT_ID + GIGACHAT_CLIENT_SECRET.
GIGACHAT_CLIENT_ID=your-gigachat-client-id
GIGACHAT_CLIENT_SECRET=your-gigachat-client-secret
GIGACHAT_AUTH_KEY=base64-of-client-id-and-secret
# Legacy (optional): GIGACHAT_API_KEY
GIGACHAT_MODEL=GigaChat
GIGACHAT_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru/api/v2/oauth
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Application Settings
SHOP_ID=default-shop
DEFAULT_LANGUAGE=ru
DEFAULT_CURRENCY=RUB

# AI Agent Settings
AGENT_NAME=AI Seller
AGENT_TONE=professional
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2048
AGENT_RAG_TOP_K=5

# RAG Settings
RAG_ENABLED=true
SALES_RAG_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# API Keys for Widget
WIDGET_API_KEY=your-widget-api-key
