# Application Settings
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_seller
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ai_seller

# Redis Settings
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# LLM Provider Settings
# GigaChat is the primary provider; Ollama is used as the fallback.
LLM_PROVIDER=gigachat
LLM_PRIMARY=gigachat
LLM_FALLBACK=ollama

# Ollama Settings (Local LLM fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# GigaChat Settings
GIGACHAT_API_KEY=your-gigachat-api-key
GIGACHAT_MODEL=GigaChat
GIGACHAT_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru/api/v2/oauth
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Application Settings
SHOP_ID=default-shop
DEFAULT_LANGUAGE=ru
DEFAULT_CURRENCY=RUB

# AI Agent Settings
AGENT_NAME=AI Seller
AGENT_TONE=professional
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2048
AGENT_RAG_TOP_K=5

# RAG Settings
RAG_ENABLED=true
SALES_RAG_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# API Keys for Widget
WIDGET_API_KEY=your-widget-api-key
